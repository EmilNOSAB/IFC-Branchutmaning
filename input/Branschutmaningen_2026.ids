    <ids:specification ifcVersion="IFC4X3_ADD2" name="#20 IfcSIUnit " instructions="Units ska vara i meter, det betyder inget värde på attribut &quot;Prefix&quot;">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
