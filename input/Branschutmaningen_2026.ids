    <ids:specification ifcVersion="IFC4X3_ADD2" name="#10 IfcRail.RAIL">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCRAIL</ids:simpleValue>
          </ids:name>
