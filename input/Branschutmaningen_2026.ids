        <ids:attribute>
          <ids:name>
            <ids:simpleValue>UnitType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>LENGTHUNIT</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="prohibited">
