    <ids:specification ifcVersion="IFC4X3_ADD2" name="#15 IfcBuiltSystem.RAILWAYTRACK" instructions="Gruppera de olika räl segment till ett byggt system med typ RAILWAYTRACK. Set som namn &quot;Tvärbanan&quot; och longName &quot;Norra Ulvsunda-Ursviks torg&quot;. Lägg till ett Pset_BuiltSystemRailwayTrack med TrackCharacteristic =NORMAL, TrackUsage = MAINTRACK, TrackNumber = 5930">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILTSYSTEM</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>RAILWAYTRACK</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILTSYSTEM</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>RAILWAYTRACK</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
        <ids:classification cardinality="required" instructions="CoClass klassificering för Funktionellt System">
          <ids:value>
            <ids:simpleValue>R</ids:simpleValue>
          </ids:value>
          <ids:system>
            <ids:simpleValue>CoClass_FS</ids:simpleValue>
          </ids:system>
        </ids:classification>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Polarexpress</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Tvärbanan</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuiltSystemRailwayTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TrackCharacteristic</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>NORMAL</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCIDENTIFIER" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuiltSystemRailwayTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TrackNumber</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>5930</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuiltSystemRailwayTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TrackUsage</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>MAINTRACK</ids:simpleValue>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
