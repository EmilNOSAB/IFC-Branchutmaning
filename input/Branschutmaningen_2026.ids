          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="#21 IfcProjectedCRS" instructions="Modellen ska ligga i &quot;SWEREF 99 18 00 + RH 2000&quot; enligt exempel från PRAXI. Man kan antingen sätta båda på en gång eller definiera horisontella och vertikala systemet separat.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECTEDCRS</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPSG:5850" />
              <xs:enumeration value="EPSG:3011" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="SWEREF 99 18 00 + RH 2000" />
              <xs:enumeration value="SWEREF 99 18 00" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="optional">
          <ids:name>
            <ids:simpleValue>VerticalDatum</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>RH 2000</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="#22 IfcCourse" instructions="Ballasten ska ha två klassificeringar en för produktionsresultatet &quot;Fyllning för spåranläggning&quot; med koden &quot;CEB.3&quot; och en för CoClass komponenten &quot;Fyllning&quot; med koden &quot;UTA10&quot;.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOURSE</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>BALLASTBED</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCRAILWAYPART</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:classification cardinality="required" instructions="CoClass Produktionsresultat (samma som BSABwr kod)">
          <ids:value>
            <ids:simpleValue>CEB.3</ids:simpleValue>
          </ids:value>
          <ids:system>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CoClass_PR" />
              <xs:enumeration value="BSAB96_PR" />
            </xs:restriction>
          </ids:system>
        </ids:classification>
        <ids:classification cardinality="required" instructions="CoClass Komponent">
          <ids:value>
            <ids:simpleValue>UTA10</ids:simpleValue>
          </ids:value>
          <ids:system>
            <ids:simpleValue>CoClass_KO</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>