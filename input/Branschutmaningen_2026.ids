              <ids:simpleValue>IFCRAILWAY</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:classification cardinality="required" instructions="CoClass klassificering för konstruktiv system">
          <ids:value>
            <ids:simpleValue>DA10</ids:simpleValue>
          </ids:value>
          <ids:system>
            <ids:simpleValue>CoClass_KS</ids:simpleValue>
          </ids:system>
        </ids:classification>
        <ids:attribute cardinality="required" instructions="GlobalId ska finnas definierad">
          <ids:name>
            <ids:simpleValue>GlobalId</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="OwnerHistory ska finnas definierad">
          <ids:name>
            <ids:simpleValue>OwnerHistory</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Name ska finnas definierad">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Description ska finnas definierad">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwayTrackStructurePart</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasBallastTrack</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>true</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwayTrackStructurePart</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasCWR</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>true</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwayTrackStructurePart</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsSunExposed</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>true</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwayTrackStructurePart</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TrackSupportingStructure</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>SUBGRADELAYER</ids:simpleValue>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
